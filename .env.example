# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# --- Meterless Runtime / Nightshift (model execution) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
# Any Nemotron id served by your Nightshift lanes; the client falls back to the first *nemotron* id it finds.
METERLESS_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Zetaris Lightning (federated SQL) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
# logical table -> Zetaris table, inline JSON or a path, e.g. zetaris/table_map.example.json
ZETARIS_TABLE_MAP=zetaris/table_map.example.json

# --- Dev fallback LLM (any OpenAI-compatible endpoint), read from ~/.secrets/cc1500.env if not set here ---
# CC1500_BASE_URL=
# CC1500_API_KEY=
# CC1500_MODEL=

# --- Optional dev fallback: NVIDIA hosted Nemotron directly (NOT the submission path; Meterless is) ---
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
